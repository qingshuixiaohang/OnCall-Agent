# ========== 应用配置 ==========
APP_NAME=SuperBizAgent
DEBUG=True
HOST=0.0.0.0
PORT=9900

# ========== DashScope 配置（对话模型，必填） ==========
# 获取地址: https://bailian.console.aliyun.com/#/api-key
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ========== SiliconFlow 配置（嵌入向量模型，必填） ==========
# 获取地址: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=your-siliconflow-api-key-here
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# ========== Milvus 配置 ==========
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# ========== RAG 配置 ==========
RAG_TOP_K=3
RAG_MODEL=qwen3.7-plus

# ========== 文档分块配置 ==========
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# ========== MCP 服务配置 ==========
MCP_CLS_TRANSPORT=sse
MCP_CLS_URL=http://localhost:3000/sse
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

# ========== 重排模型配置 ==========
RERANK_BACKEND=siliconflow
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RETRIEVAL_K=9

# ========== CORS 配置 ==========
CORS_ORIGINS=http://localhost:5173,http://localhost:9900

# ========== 上下文压缩配置 ==========
CONTEXT_MAX_TOKENS=32768
CONTEXT_COMPRESSION_THRESHOLD=0.7
CONTEXT_KEEP_RECENT=4

# ========== 记忆存储配置 ==========
STORAGE_BACKEND=sqlite
STORAGE_SQLITE_PATH=./volumes/langgraph.db
# 生产环境使用 PostgreSQL:
# STORAGE_BACKEND=postgresql
# STORAGE_POSTGRES_URL=postgresql://langgraph:langgraph@localhost:5432/langgraph
STORAGE_MAX_HISTORY=100
STORAGE_SESSION_TTL=86400

# Mem0 默认按机器生成持久匿名 ID；多用户部署时建议配置认证用户 ID
# MEM0_USER_ID=your-user-id
MEM0_SAVE_TIMEOUT=60

# ========== LangSmith 配置（可观测性，可选） ==========
# 注册地址: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=OnCall-Agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ========== 腾讯云配置（CLS 日志 MCP 服务） ==========
TENCENTCLOUD_SECRET_ID=your-tencentcloud-secret-id-here
TENCENTCLOUD_SECRET_KEY=your-tencentcloud-secret-key-here
